# ==============================================================================
# OPEN ANALYTICS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development or deploy to your production env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# MongoDB connection string (supports MongoDB Atlas SRV or local replica set)
# ------------------------------------------------------------------------------
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/open_analytics?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 2. APPLICATION RUNTIME & SECURITY (Required)
# ------------------------------------------------------------------------------
# Public URL of the Open Analytics deployment (used for CORS and OAuth redirect callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# Cryptographic secret for signing JWT session tokens (generate via `openssl rand -hex 32`)
JWT_SECRET="open_analytics_super_secret_jwt_key_2026_production_change_me!"

# Node Environment ("development" or "production")
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (Optional — for Google Single Sign-On)
# Obtain from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
# Authorized redirect URI: http://localhost:3005/api/auth/oauth/google/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 4. GITHUB OAUTH 2.0 (Optional — for GitHub Single Sign-On)
# Obtain from GitHub (Settings > Developer settings > OAuth Apps > New OAuth App)
# Authorization callback URL: http://localhost:3005/api/auth/oauth/github/callback
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
